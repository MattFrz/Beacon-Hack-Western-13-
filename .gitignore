# Loaner QSTI staging (Wi-Fi PSK, onboot). Do not commit.
sd-stage/

# Large model files (see models/README.md)
__pycache__/
*.py[cod]
*.onnx
*.onnx.data
*.tflite
*.task
*.gguf
*.pt
*.part
models/*.bin

# Laptop/C270 intrinsics: local calibration only, never commit
models/calib.json

# Build output
build/
*.o
camd/camd
camd/read-frames
camd/dump-frame
camd/deadline-test
camd/layout-probe
percept/percept-head

# Laptop (Node)
node_modules/
dist/
laptop/bridge/recordings/

# graphify: share the graph, not its cache or machine-specific paths
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/graph.html
